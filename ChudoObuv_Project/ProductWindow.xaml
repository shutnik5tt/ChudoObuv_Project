<Window x:Class="ChudoObuv_Project.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Просмотр товара" Height="600" Width="850"
        WindowStartupLocation="CenterOwner" Icon="Resources/icon.ico"
        FontFamily="Calibri" FontSize="16" Background="White">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" x:Name="ProductImage" Width="260" Height="220"
               Stretch="Uniform" VerticalAlignment="Top"/>

        <StackPanel Grid.Column="1">
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="CategoryText" Margin="0,8,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Цена: "/>
                <TextBlock x:Name="OldPriceText" TextDecorations="Strikethrough" Margin="0,0,8,0"/>
                <TextBlock x:Name="PriceText" FontWeight="Bold"/>
            </StackPanel>

            <TextBlock x:Name="CompositionText" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="DescriptionText" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="SizeRangeText" Margin="0,8,0,0" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <TextBlock Text="Размер:" VerticalAlignment="Center"/>
                <ComboBox x:Name="SizeBox" Width="200" Height="28" Margin="8,0,20,0"
                          DisplayMemberPath="Display"/>
                <TextBlock Text="Количество пар:" VerticalAlignment="Center"/>
                <TextBox x:Name="QuantityBox" Width="60" Height="28" Margin="8,0,0,0" Text="1"
                         MaxLength="4" VerticalContentAlignment="Center"
                         PreviewTextInput="QuantityBox_PreviewTextInput"
                         ToolTip="Целое число не больше доступного количества"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,25,0,0">
                <Button x:Name="AddButton" Content="Добавить в заказ" Width="160" Height="36"
                        Background="{StaticResource AccentBrush}" BorderThickness="0" Click="Add_Click"/>
                <Button Content="Назад" Width="100" Height="36" Margin="10,0,0,0" Click="Back_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
