<Window x:Class="ChudoObuv_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Каталог товаров" Height="650" Width="1000"
        Icon="Resources/icon.ico"
        FontFamily="Calibri" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#D2F6E7" Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <Image Source="Resources/logo.png" Height="70" Stretch="Uniform"/>
                <TextBlock Text="Чудо Обувь — Каталог товаров" FontSize="26" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="15,0,0,0"/>
            </StackPanel>
        </Border>

        <ListBox x:Name="ProductsList" Grid.Row="1" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="10,5" Padding="10" BorderThickness="1" BorderBrush="#70B2AF"
                            Background="{Binding CardBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <!-- картинка (пока пустая) -->
                            <Image Grid.Column="0" Source="{Binding Image}"
                                   Width="140" Height="110" Stretch="Uniform"/>

                            <!-- центр: Производство | Наименование, ниже Категория / Количество / Состав -->
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="{Binding Title}" FontSize="18"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding CategoryText}" FontSize="16" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding QuantityText}" FontSize="16" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Composition}" FontSize="13"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding PriceText}" FontSize="22"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
