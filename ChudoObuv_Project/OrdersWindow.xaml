<Window x:Class="ChudoObuv_Project.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Заказы" Height="650" Width="900"
        WindowStartupLocation="CenterOwner" Icon="Resources/icon.ico"
        FontFamily="Calibri" FontSize="16" Background="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Список заказов" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column"
                  SelectionChanged="OrdersGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding OrderDate, StringFormat=dd.MM.yyyy HH:mm}" Width="160"/>
                <DataGridTextColumn Header="ФИО клиента" Binding="{Binding ClientName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="Состав заказа" FontSize="18" FontWeight="Bold" Margin="0,10,0,5"/>

        <DataGrid Grid.Row="3" x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductText}" Width="*"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="80"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Цена за единицу, ₽" Binding="{Binding PricePerUnit}" Width="150"/>
                <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Sum}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" x:Name="TotalText" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Right" Margin="0,10,0,0"/>

        <WrapPanel Grid.Row="5" Margin="0,15,0,0">
            <Button Content="Добавить заказ" Width="150" Height="36" Background="{StaticResource AccentBrush}"
                    BorderThickness="0" Click="AddOrder_Click"/>
            <Button Content="Удалить заказ" Width="140" Height="36" Margin="10,0,0,0" Click="DeleteOrder_Click"/>
            <StackPanel x:Name="AdminPanel" Orientation="Horizontal">
                <Button Content="Удалить позицию" Width="150" Height="36" Margin="10,0,0,0" Click="DeleteItem_Click"/>
                <DatePicker x:Name="DateBox" Width="130" Height="30" Margin="20,0,0,0"
                            VerticalContentAlignment="Center"/>
                <Button Content="Изменить дату" Width="130" Height="36" Margin="10,0,0,0" Click="ChangeDate_Click"/>
            </StackPanel>
            <Button Content="Назад" Width="100" Height="36" Margin="10,0,0,0" Click="Back_Click"/>
        </WrapPanel>
    </Grid>
</Window>
