<Window x:Class="ChudoObuv_Project.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Вход" Height="450" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="Resources/icon.ico"
        FontFamily="Calibri" FontSize="16" Background="White">
    <StackPanel Margin="30" VerticalAlignment="Center">
        <Image Source="Resources/logo.png" Height="110" Stretch="Uniform"/>
        <TextBlock Text="Вход в систему" FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,10,0,20"/>

        <TextBlock Text="Логин"/>
        <TextBox x:Name="LoginBox" Height="30" Margin="0,4,0,20" MaxLength="50"
                 VerticalContentAlignment="Center" PreviewTextInput="LoginBox_PreviewTextInput"
                 ToolTip="Введите логин без пробелов"/>

        <Button Content="Войти" Height="36" Background="{StaticResource AccentBrush}" BorderThickness="0"
                IsDefault="True" Click="Login_Click"/>
        <Button Content="Войти как гость" Height="36" Margin="0,10,0,0"
                Background="{StaticResource SecondaryBrush}" BorderThickness="0" Click="Guest_Click"/>
    </StackPanel>
</Window>
