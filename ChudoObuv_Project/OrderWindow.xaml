<Window x:Class="ChudoObuv_Project.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Оформление заказа" Height="520" Width="820"
        WindowStartupLocation="CenterOwner" Icon="Resources/icon.ico"
        FontFamily="Calibri" FontSize="16" Background="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ваш заказ" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" x:Name="LinesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductText}" Width="*"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="80"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Цена, ₽" Binding="{Binding PricePerUnit}" Width="90"/>
                <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Sum}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" x:Name="TotalText" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Right" Margin="0,10,0,0"/>

        <WrapPanel Grid.Row="3" Margin="0,15,0,0">
            <Button Content="Удалить позицию" Width="150" Height="36" Click="DeleteLine_Click"/>
            <TextBox x:Name="QuantityBox" Width="70" Height="30" Margin="20,0,0,0" Text="1"
                     MaxLength="4" VerticalContentAlignment="Center"
                     PreviewTextInput="QuantityBox_PreviewTextInput"
                     ToolTip="Новое количество для выбранной позиции"/>
            <Button Content="Изменить количество" Width="170" Height="36" Margin="10,0,0,0" Click="ChangeQuantity_Click"/>
            <Button Content="Отменить заказ" Width="140" Height="36" Margin="20,0,0,0" Click="CancelOrder_Click"/>
            <Button Content="Подтвердить заказ" Width="170" Height="36" Margin="10,0,0,0"
                    Background="{StaticResource AccentBrush}" BorderThickness="0" Click="Confirm_Click"/>
            <Button Content="Назад" Width="100" Height="36" Margin="10,0,0,0" Click="Back_Click"/>
        </WrapPanel>
    </Grid>
</Window>
